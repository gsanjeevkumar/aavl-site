# .env.example
# Gmail SMTP credentials for contact form email delivery
# Requires a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=Recoveraccidentvalue@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=Recoveraccidentvalue@gmail.com
